class PDFCanvas(QWidget):
    """لوحة رسم PDF مع دعم التفاعل"""
    
    # إشارات
    pageClicked = pyqtSignal(int, QPoint)  # (page_num, position)
    zoomChanged = pyqtSignal(float)
    viewportChanged = pyqtSignal(QRect)
    annotationAdded = pyqtSignal(dict)
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.parent = parent
        self.pdf_handler = None
        
        # حالة العرض
        self.current_page = 0
        self.zoom_level = 1.5
        self.rotation = 0
        self.page_image = None
        self.image_offset = QPoint(0, 0)
        
        # وضع التفاعل
        self.interaction_mode = "hand"  # hand, select, highlight, note
        self.is_panning = False
        self.pan_start_pos = QPoint()
        self.viewport_offset = QPoint(0, 0)
        
        # التعليقات التوضيحية
        self.current_annotation = None
        self.annotation_start = QPoint()
        
        # التحديد
        self.selection_rect = QRect()
        self.has_selection = False
        
        # التخصيص
        self.show_annotations = True
        self.show_grid = False
        self.grid_size = 20
        self.backgroundColor = QColor(240, 240, 240)
        self.pageShadowColor = QColor(100, 100, 100, 100)
        
        # تحسينات الأداء
        self.cache_enabled = True
        self.image_cache = {}
        self.max_cache_size = 10
        
        self.setMouseTracking(True)
        self.setMinimumSize(400, 400)
        self.setFocusPolicy(Qt.StrongFocus)
        
        # إعداد السياق
        self.setContextMenuPolicy(Qt.CustomContextMenu)
        self.customContextMenuRequested.connect(self.show_context_menu)
        
    def set_pdf_handler(self, handler):
        """تعيين معالج PDF"""
        self.pdf_handler = handler
        if handler and handler.total_pages > 0:
            self.current_page = 0
            self.load_page_image()
    
    def load_page_image(self):
        """تحميل صورة الصفحة الحالية"""
        if not self.pdf_handler:
            return
        
        # التحقق من وجود الصفحة في الذاكرة المؤقتة
        cache_key = f"{self.current_page}_{self.zoom_level}_{self.rotation}"
        
        if self.cache_enabled and cache_key in self.image_cache:
            self.page_image = self.image_cache[cache_key]
        else:
            # تحميل الصورة الجديدة
            self.page_image = self.pdf_handler.get_page_image(
                self.current_page, 
                self.zoom_level,
                self.rotation
            )
            
            # تخزين في الذاكرة المؤقتة
            if self.cache_enabled and self.page_image:
                self.image_cache[cache_key] = self.page_image
                
                # التحكم في حجم الذاكرة المؤقتة
                if len(self.image_cache) > self.max_cache_size:
                    oldest_key = next(iter(self.image_cache))
                    del self.image_cache[oldest_key]
        
        self.update()
        self.zoomChanged.emit(self.zoom_level)
    
    def paintEvent(self, event):
        """رسم اللوحة"""
        painter = QPainter(self)
        
        # خلفية
        painter.fillRect(self.rect(), self.backgroundColor)
        
        if self.page_image:
            # حساب إزاحة الصورة للتمركز
            img_width = self.page_image.width
            img_height = self.page_image.height
            
            available_width = self.width() - 40  # هوامش
            available_height = self.height() - 40
            
            # حساب نسبة التكبير التلقائي إذا لزم
            if self.zoom_level <= 0:
                width_ratio = available_width / img_width
                height_ratio = available_height / img_height
                auto_zoom = min(width_ratio, height_ratio) * 0.95
                self.zoom_level = auto_zoom
                self.load_page_image()
                return
            
            # تطبيق إزاحة العرض
            offset_x = (self.width() - img_width) // 2 + self.viewport_offset.x()
            offset_y = (self.height() - img_height) // 2 + self.viewport_offset.y()
            
            # حفظ الإزاحة
            self.image_offset = QPoint(offset_x, offset_y)
            
            # رسم ظل الصفحة
            if self.pageShadowColor:
                shadow_rect = QRect(
                    offset_x + 5,
                    offset_y + 5,
                    img_width,
                    img_height
                )
                painter.fillRect(shadow_rect, self.pageShadowColor)
            
            # رسم الصورة
            qimage = QImage(
                self.page_image.tobytes(),
                img_width,
                img_height,
                QImage.Format_RGB888
            )
            
            painter.drawImage(offset_x, offset_y, qimage)
            
            # رسم الشبكة إذا مفعلة
            if self.show_grid:
                self.draw_grid(painter, offset_x, offset_y, img_width, img_height)
            
            # رسم التعليقات التوضيحية
            if self.show_annotations and self.pdf_handler:
                self.draw_annotations(painter, offset_x, offset_y)
            
            # رسم التحديد الحالي
            if self.has_selection and not self.selection_rect.isEmpty():
                self.draw_selection(painter, offset_x, offset_y)
            
            # رسم التعليق قيد الإنشاء
            if self.current_annotation:
                self.draw_current_annotation(painter, offset_x, offset_y)
            
            # رسم حدود الصفحة
            painter.setPen(QPen(QColor(100, 100, 100), 1))
            painter.drawRect(offset_x, offset_y, img_width, img_height)
            
            # معلومات الصفحة في الزاوية
            if self.pdf_handler:
                page_info = f"الصفحة {self.current_page + 1}/{self.pdf_handler.total_pages}"
                painter.setPen(QColor(0, 0, 0))
                painter.drawText(offset_x + 10, offset_y + 20, page_info)
    
    def draw_grid(self, painter, offset_x, offset_y, width, height):
        """رسم الشبكة"""
        grid_color = QColor(200, 200, 200, 100)
        painter.setPen(QPen(grid_color, 1, Qt.DotLine))
        
        # خطوط عمودية
        for x in range(offset_x, offset_x + width, self.grid_size):
            painter.drawLine(x, offset_y, x, offset_y + height)
        
        # خطوط أفقية
        for y in range(offset_y, offset_y + height, self.grid_size):
            painter.drawLine(offset_x, y, offset_x + width, y)
    
    def draw_annotations(self, painter, offset_x, offset_y):
        """رسم التعليقات التوضيحية"""
        if not self.pdf_handler:
            return
        
        annotations = self.pdf_handler.get_page_annotations(self.current_page)
        
        for annotation in annotations:
            ann_type = annotation['type']
            points = annotation['points']
            color = annotation['color']
            
            qcolor = QColor(
                int(color[0] * 255),
                int(color[1] * 255),
                int(color[2] * 255),
                150  # شفافية
            )
            
            painter.setPen(QPen(qcolor, 2))
            
            if ann_type == "highlight":
                painter.setBrush(QColor(255, 255, 0, 100))
                if len(points) == 4:  # [x, y, width, height]
                    rect = QRect(
                        offset_x + points[0],
                        offset_y + points[1],
                        points[2],
                        points[3]
                    )
                    painter.drawRect(rect)
            
            elif ann_type == "underline":
                painter.setBrush(Qt.NoBrush)
                if len(points) >= 2:
                    painter.drawLine(
                        offset_x + points[0],
                        offset_y + points[1],
                        offset_x + points[2],
                        offset_y + points[3]
                    )
            
            elif ann_type == "rectangle":
                painter.setBrush(Qt.NoBrush)
                if len(points) == 4:
                    rect = QRect(
                        offset_x + points[0],
                        offset_y + points[1],
                        points[2],
                        points[3]
                    )
                    painter.drawRect(rect)
            
            elif ann_type == "circle":
                painter.setBrush(Qt.NoBrush)
                if len(points) == 4:
                    rect = QRect(
                        offset_x + points[0],
                        offset_y + points[1],
                        points[2],
                        points[3]
                    )
                    painter.drawEllipse(rect)
            
            elif ann_type == "text" and annotation.get('text'):
                # رسم نص التعليق
                painter.setPen(QColor(0, 0, 0))
                if len(points) >= 2:
                    painter.drawText(
                        offset_x + points[0],
                        offset_y + points[1] + 15,  # إزاحة للنص
                        annotation['text']
                    )
    
    def draw_selection(self, painter, offset_x, offset_y):
        """رسم منطقة التحديد"""
        selection_color = QColor(0, 120, 215, 50)
        border_color = QColor(0, 120, 215)
        
        # تعبئة المنطقة
        painter.setBrush(selection_color)
        painter.setPen(QPen(border_color, 1, Qt.DashLine))
        
        selection_rect = self.selection_rect.translated(offset_x, offset_y)
        painter.drawRect(selection_rect)
    
    def draw_current_annotation(self, painter, offset_x, offset_y):
        """رسم التعليق الحالي قيد الإنشاء"""
        if not self.current_annotation:
            return
        
        ann_type = self.current_annotation['type']
        start = self.current_annotation['start']
        end = self.current_annotation['end']
        
        if start is None or end is None:
            return
        
        # حساب المستطيل
        rect = QRect(start, end).normalized()
        
        # اختيار اللون حسب النوع
        if ann_type == "highlight":
            color = QColor(255, 255, 0, 100)
            painter.setBrush(color)
            painter.setPen(QPen(QColor(200, 200, 0), 1))
        elif ann_type == "rectangle":
            color = QColor(255, 0, 0, 50)
            painter.setBrush(Qt.NoBrush)
            painter.setPen(QPen(QColor(255, 0, 0), 2))
        elif ann_type == "circle":
            color = QColor(0, 255, 0, 50)
            painter.setBrush(Qt.NoBrush)
            painter.setPen(QPen(QColor(0, 255, 0), 2))
        else:  # خط أو نص
            painter.setBrush(Qt.NoBrush)
            painter.setPen(QPen(QColor(0, 0, 255), 2))
        
        # الرسم
        if ann_type in ["rectangle", "highlight"]:
            painter.drawRect(rect.translated(offset_x, offset_y))
        elif ann_type == "circle":
            painter.drawEllipse(rect.translated(offset_x, offset_y))
        elif ann_type in ["underline", "strikeout"]:
            y_pos = start.y() if ann_type == "underline" else start.y() + rect.height() / 2
            painter.drawLine(
                offset_x + start.x(),
                offset_y + y_pos,
                offset_x + end.x(),
                offset_y + y_pos
            )
    
    def mousePressEvent(self, event):
        """معالجة ضغط الماوس"""
        pos = event.pos()
        
        if event.button() == Qt.LeftButton:
            if self.interaction_mode == "hand":
                # بدء التمرير
                self.is_panning = True
                self.pan_start_pos = pos
                self.setCursor(Qt.ClosedHandCursor)
                
            elif self.interaction_mode in ["highlight", "rectangle", "circle", "underline", "strikeout"]:
                # بدء رسم تعليق
                self.start_annotation(pos)
                
            elif self.interaction_mode == "select":
                # بدء التحديد
                self.start_selection(pos)
        
        elif event.button() == Qt.RightButton:
            # يمكن معالجة قائمة السياق هنا
            pass
        
        self.update()
    
    def mouseMoveEvent(self, event):
        """معالجة حركة الماوس"""
        pos = event.pos()
        
        if self.is_panning:
            # التمرير
            delta = pos - self.pan_start_pos
            self.viewport_offset += delta
            self.pan_start_pos = pos
            self.update()
            self.viewportChanged.emit(self.get_viewport_rect())
            
        elif self.current_annotation and self.current_annotation['start']:
            # تحديث التعليق قيد الرسم
            self.update_annotation(pos)
            
        elif self.has_selection:
            # تحديث التحديد
            self.update_selection(pos)
        
        # تحديث موضع المؤشر في شريط الحالة
        if hasattr(self.parent, 'update_cursor_position'):
            self.parent.update_cursor_position(pos)
    
    def mouseReleaseEvent(self, event):
        """معالجة تحرير الماوس"""
        if event.button() == Qt.LeftButton:
            if self.is_panning:
                # إنهاء التمرير
                self.is_panning = False
                self.setCursor(Qt.ArrowCursor)
                
            elif self.current_annotation and self.current_annotation['start']:
                # إنهاء رسم التعليق
                self.finish_annotation()
                
            elif self.has_selection:
                # إنهاء التحديد
                self.finish_selection()
        
        self.update()
    
    def wheelEvent(self, event):
        """معالجة عجلة الماوس"""
        modifiers = event.modifiers()
        delta = event.angleDelta().y()
        
        if modifiers & Qt.ControlModifier:
            # التكبير/التصغير
            if delta > 0:
                self.zoom_in()
            else:
                self.zoom_out()
            event.accept()
            
        elif modifiers & Qt.ShiftModifier:
            # التنقل أفقي بين الصفحات
            if delta > 0:
                self.previous_page()
            else:
                self.next_page()
            event.accept()
            
        else:
            # تمرير عمودي
            super().wheelEvent(event)
    
    def start_annotation(self, pos):
        """بدء رسم تعليق توضيحي"""
        # التحقق من أن النقر داخل حدود الصورة
        if not self.is_point_inside_image(pos):
            return
        
        # تعديل الإحداثيات بالنسبة لموقع الصورة
        img_pos = pos - self.image_offset
        
        self.current_annotation = {
            'type': self.interaction_mode,
            'start': img_pos,
            'end': img_pos,
            'color': self.get_annotation_color()
        }
    
    def update_annotation(self, pos):
        """تحديث التعليق أثناء الرسم"""
        if not self.current_annotation or not self.is_point_inside_image(pos):
            return
        
        img_pos = pos - self.image_offset
        self.current_annotation['end'] = img_pos
        self.update()
    
    def finish_annotation(self):
        """إنهاء رسم التعليق وحفظه"""
        if not self.current_annotation or not self.pdf_handler:
            return
        
        start = self.current_annotation['start']
        end = self.current_annotation['end']
        
        if start == end:
            self.current_annotation = None
            return
        
        # حساب نقاط التعليق
        rect = QRect(start, end).normalized()
        points = [rect.x(), rect.y(), rect.width(), rect.height()]
        
        # إضافة التعليق إلى معالج PDF
        annotation_id = self.pdf_handler.add_annotation(
            self.current_page,
            self.current_annotation['type'],
            points,
            self.current_annotation['color']
        )
        
        # إرسال إشارة
        annotation_data = {
            'id': annotation_id,
            'type': self.current_annotation['type'],
            'page': self.current_page,
            'rect': rect
        }
        self.annotationAdded.emit(annotation_data)
        
        self.current_annotation = None
        self.update()
    
    def start_selection(self, pos):
        """بدء تحديد منطقة"""
        if not self.is_point_inside_image(pos):
            return
        
        img_pos = pos - self.image_offset
        self.selection_rect = QRect(img_pos, QSize(0, 0))
        self.has_selection = True
    
    def update_selection(self, pos):
        """تحديث منطقة التحديد"""
        if not self.has_selection or not self.is_point_inside_image(pos):
            return
        
        img_pos = pos - self.image_offset
        self.selection_rect.setBottomRight(img_pos)
        self.update()
    
    def finish_selection(self):
        """إنهاء التحديد"""
        if self.has_selection and not self.selection_rect.isEmpty():
            # هنا يمكن نسخ النص المحدد أو تنفيذ إجراء آخر
            text = self.get_selected_text()
            if text:
                print(f"النص المحدد: {text}")
        
        self.has_selection = False
        self.selection_rect = QRect()
        self.update()
    
    def get_selected_text(self):
        """الحصول على النص في المنطقة المحددة"""
        if not self.pdf_handler or not self.has_selection:
            return ""
        
        # هذا تبسيط - في التطبيق الحقيقي تحتاج لتحويل الإحداثيات
        try:
            page_text = self.pdf_handler.get_page_text(self.current_page)
            return page_text  # سيعيد كل نص الصفحة في هذا المثال
        except:
            return ""
    
    def is_point_inside_image(self, pos):
        """التحقق إذا كانت النقطة داخل حدود الصورة"""
        if not self.page_image:
            return False
        
        img_width = self.page_image.width
        img_height = self.page_image.height
        
        return (
            self.image_offset.x() <= pos.x() <= self.image_offset.x() + img_width and
            self.image_offset.y() <= pos.y() <= self.image_offset.y() + img_height
        )
    
    def get_viewport_rect(self):
        """الحصول على منطقة العرض الحالية"""
        if not self.page_image:
            return QRect()
        
        return QRect(
            -self.viewport_offset.x(),
            -self.viewport_offset.y(),
            self.width(),
            self.height()
        )
    
    def get_annotation_color(self):
        """الحصول على لون التعليق حسب النوع"""
        if self.interaction_mode == "highlight":
            return (1.0, 1.0, 0.0)  # أصفر
        elif self.interaction_mode == "underline":
            return (0.0, 0.0, 1.0)  # أزرق
        elif self.interaction_mode == "strikeout":
            return (1.0, 0.0, 0.0)  # أحمر
        elif self.interaction_mode == "rectangle":
            return (0.0, 1.0, 0.0)  # أخضر
        elif self.interaction_mode == "circle":
            return (1.0, 0.0, 1.0)  # أرجواني
        else:
            return (0.5, 0.5, 0.5)  # رمادي
    
    # ============================================================================
    # عمليات التنقل
    # ============================================================================
    
    def next_page(self):
        """الصفحة التالية"""
        if self.pdf_handler and self.current_page < self.pdf_handler.total_pages - 1:
            self.current_page += 1
            self.load_page_image()
            self.pageClicked.emit(self.current_page, QPoint())
    
    def previous_page(self):
        """الصفحة السابقة"""
        if self.pdf_handler and self.current_page > 0:
            self.current_page -= 1
            self.load_page_image()
            self.pageClicked.emit(self.current_page, QPoint())
    
    def goto_page(self, page_num):
        """الانتقال إلى صفحة محددة"""
        if self.pdf_handler and 0 <= page_num < self.pdf_handler.total_pages:
            self.current_page = page_num
            self.load_page_image()
            self.pageClicked.emit(self.current_page, QPoint())
    
    # ============================================================================
    # عمليات التكبير/التصغير
    # ============================================================================
    
    def zoom_in(self):
        """تكبير"""
        self.zoom_level = min(self.zoom_level + 0.2, 5.0)
        self.load_page_image()
    
    def zoom_out(self):
        """تصغير"""
        self.zoom_level = max(self.zoom_level - 0.2, 0.2)
        self.load_page_image()
    
    def zoom_to_fit(self):
        """تكبير لملاءمة العرض"""
        if self.page_image:
            width_ratio = self.width() / self.page_image.width
            height_ratio = self.height() / self.page_image.height
            self.zoom_level = min(width_ratio, height_ratio) * 0.95
            self.load_page_image()
    
    def zoom_to_actual(self):
        """تكبير 100%"""
        self.zoom_level = 1.0
        self.load_page_image()
    
    def rotate_left(self):
        """تدوير عكس عقارب الساعة"""
        self.rotation = (self.rotation - 90) % 360
        self.load_page_image()
    
    def rotate_right(self):
        """تدوير مع عقارب الساعة"""
        self.rotation = (self.rotation + 90) % 360
        self.load_page_image()
    
    # ============================================================================
    # إعدادات العرض
    # ============================================================================
    
    def set_interaction_mode(self, mode):
        """تعيين وضع التفاعل"""
        valid_modes = ["hand", "select", "highlight", "underline", 
                      "strikeout", "rectangle", "circle", "note"]
        
        if mode in valid_modes:
            self.interaction_mode = mode
            
            # تغيير شكل المؤشر
            if mode == "hand":
                self.setCursor(Qt.OpenHandCursor)
            elif mode in ["select", "highlight"]:
                self.setCursor(Qt.CrossCursor)
            elif mode == "note":
                self.setCursor(Qt.IBeamCursor)
            else:
                self.setCursor(Qt.ArrowCursor)
    
    def toggle_annotations(self, show):
        """تفعيل/تعطيل عرض التعليقات"""
        self.show_annotations = show
        self.update()
    
    def toggle_grid(self, show):
        """تفعيل/تعطيل الشبكة"""
        self.show_grid = show
        self.update()
    
    def set_background_color(self, color):
        """تعيين لون الخلفية"""
        self.backgroundColor = color
        self.update()
    
    def clear_cache(self):
        """مسح الذاكرة المؤقتة"""
        self.image_cache.clear()
    
    def show_context_menu(self, pos):
        """عرض قائمة السياق"""
        # يمكن إضافة قائمة السياق هنا
        pass


class MainWindow(QMainWindow):
    """النافذة الرئيسية للتطبيق"""
    
    def __init__(self):
        super().__init__()
        
        # تهيئة المتغيرات
        self.pdf_handler = PDFHandler()
        self.theme_manager = ThemeManager()
        self.settings = QSettings("PDFReader", "ProfessionalPDFReader")
        
        # حالة التطبيق
        self.current_file = None
        self.recent_files = []
        self.is_fullscreen = False
        self.window_state_before_fullscreen = None
        
