    def open_file(self, file_path=None):
        """فتح ملف PDF"""
        if not file_path:
            file_path, _ = QFileDialog.getOpenFileName(
                self,
                "فتح ملف PDF",
                "",
                "ملفات PDF (*.pdf);;جميع الملفات (*)"
            )
        
        if file_path:
            self.show_progress("جاري فتح الملف...")
            
            success, message = self.pdf_handler.open_pdf(file_path)
            
            if success:
                self.current_file = file_path
                
                # تحديث العنوان
                self.setWindowTitle(f"قارئ PDF - {os.path.basename(file_path)}")
                
                # تحديث شريط الحالة
                self.file_label.setText(f"الملف: {os.path.basename(file_path)}")
                
                # تحديث عرض PDF
                self.pdf_canvas.set_pdf_handler(self.pdf_handler)
                self.pdf_canvas.goto_page(0)
                
                # تحديث الصفحات المصغرة
                self.thumbnail_panel.load_thumbnails(self.pdf_handler)
                
                # تحديث الشريط الجانبي
                self.sidebar.update_info(self.pdf_handler)
                
                # إضافة إلى الملفات الحديثة
                self.add_to_recent_files(file_path)
                
                # عرض رسالة النجاح
                self.status_bar.showMessage(f"✅ {message}", 3000)
                
            else:
                QMessageBox.critical(self, "خطأ", message)
            
            self.hide_progress()
    
    def save_file(self):
        """حفظ الملف"""
        if not self.current_file:
            self.save_file_as()
            return
        
        success, message = self.pdf_handler.save_pdf(self.current_file)
        
        if success:
            self.status_bar.showMessage(f"✅ {message}", 3000)
        else:
            QMessageBox.critical(self, "خطأ", message)
    
    def save_file_as(self):
        """حفظ الملف باسم جديد"""
        if not self.pdf_handler.doc:
            QMessageBox.warning(self, "تحذير", "لا يوجد ملف مفتوح للحفظ")
            return
        
        file_path, _ = QFileDialog.getSaveFileName(
            self,
            "حفظ ملف PDF",
            "",
            "ملفات PDF (*.pdf);;جميع الملفات (*)"
        )
        
        if file_path:
            success, message = self.pdf_handler.save_pdf(file_path)
            
            if success:
                self.current_file = file_path
                self.setWindowTitle(f"قارئ PDF - {os.path.basename(file_path)}")
                self.status_bar.showMessage(f"✅ {message}", 3000)
            else:
                QMessageBox.critical(self, "خطأ", message)
    
    def print_file(self):
        """طباعة الملف"""
        # سيتم تنفيذ الطباعة في إصدار لاحق
        QMessageBox.information(self, "طباعة", "ميزة الطباعة قيد التطوير")
    
