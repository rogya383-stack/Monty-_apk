    def export_to_text(self):
        """تصدير PDF إلى نص"""
        if not self.pdf_handler.doc:
            QMessageBox.warning(self, "تحذير", "لا يوجد ملف مفتوح للتصدير")
            return
        
        dialog = ExportDialog(self.pdf_handler.total_pages, self)
        if dialog.exec_():
            params = dialog.get_export_params()
            
            file_path, _ = QFileDialog.getSaveFileName(
                self,
                "تصدير إلى نص",
                "",
                "ملفات النص (*.txt);;جميع الملفات (*)"
            )
            
            if file_path:
                self.show_progress("جاري التصدير...")
                
                success = self.pdf_handler.export_to_text(
                    file_path,
                    params['start_page'],
                    params['end_page'],
                    params['include_comments']
                )
                
                if success:
                    self.status_bar.showMessage(f"✅ تم تصدير النص بنجاح", 3000)
                    QMessageBox.information(self, "نجاح", f"تم تصدير النص إلى:\n{file_path}")
                else:
                    QMessageBox.critical(self, "خطأ", "فشل في تصدير النص")
                
                self.hide_progress()
    
    def extract_images(self):
        """استخراج الصور من PDF"""
        if not self.pdf_handler.doc:
            QMessageBox.warning(self, "تحذير", "لا يوجد ملف مفتوح")
            return
        
        folder_path = QFileDialog.getExistingDirectory(
            self,
            "اختر مجلد لحفظ الصور",
            ""
        )
        
        if folder_path:
            self.show_progress("جاري استخراج الصور...")
            
            images = self.pdf_handler.extract_images(folder_path)
            
            if images:
                self.status_bar.showMessage(f"✅ تم استخراج {len(images)} صورة", 3000)
                QMessageBox.information(
                    self,
                    "نجاح",
                    f"تم استخراج {len(images)} صورة إلى:\n{folder_path}"
                )
            else:
                QMessageBox.information(self, "معلومات", "لا توجد صور في الملف")
            
            self.hide_progress()
    
