            self.thumbnail_panel.select_thumbnail(page_num)
            self.sidebar.update_page_info(page_num)
    
    def first_page(self):
        """الذهاب إلى الصفحة الأولى"""
        self.pdf_canvas.goto_page(0)
    
    def last_page(self):
        """الذهاب إلى الصفحة الأخيرة"""
        if self.pdf_handler:
            self.pdf_canvas.goto_page(self.pdf_handler.total_pages - 1)
    
    def goto_page(self):
        """الذهاب إلى صفحة محددة"""
        if not self.pdf_handler.doc:
            return
        
        dialog = GotoPageDialog(self.pdf_handler.total_pages, self)
        if dialog.exec_():
            page_num = dialog.get_page_number()
            self.pdf_canvas.goto_page(page_num - 1)
    
    def show_search_dialog(self):
        """إظهار نافذة البحث"""
        if not self.pdf_handler.doc:
            return
        
        dialog = SearchDialog(self)
        if dialog.exec_():
            search_text, case_sensitive = dialog.get_search_params()
            self.search_text = search_text
            self.case_sensitive = case_sensitive
            
            results = self.pdf_handler.search_in_pdf(search_text, case_sensitive)
            
            if results:
                self.search_results = results
                self.current_search_index = 0
                self.navigate_to_search_result(self.current_search_index)
                
                self.status_bar.showMessage(f"تم العثور على {len(results)} نتيجة", 3000)
            else:
                QMessageBox.information(self, "بحث", "لم يتم العثور على نتائج")
    
    def find_next(self):
        """البحث عن التالي"""
        if hasattr(self, 'search_results') and self.search_results:
            self.current_search_index = (self.current_search_index + 1) % len(self.search_results)
            self.navigate_to_search_result(self.current_search_index)
    
    def find_previous(self):
        """البحث عن السابق"""
        if hasattr(self, 'search_results') and self.search_results:
            self.current_search_index = (self.current_search_index - 1) % len(self.search_results)
            self.navigate_to_search_result(self.current_search_index)
    
    def navigate_to_search_result(self, index):
        """التنقل إلى نتيجة بحث"""
        if 0 <= index < len(self.search_results):
            result = self.search_results[index]
            self.pdf_canvas.goto_page(result['page'])
            self.current_search_index = index
            self.status_bar.showMessage(f"النتيجة {index + 1} من {len(self.search_results)}", 2000)
    
    # ============================================================================
    # التكبير والتدوير
    # ============================================================================
    
    def zoom_in(self):
        """تكبير"""
        self.pdf_canvas.zoom_in()
    
    def zoom_out(self):
        """تصغير"""
        self.pdf_canvas.zoom_out()
    
    def zoom_fit(self):
        """تكبير لملاءمة العرض"""
        self.pdf_canvas.zoom_to_fit()
    
    def zoom_actual(self):
        """تكبير 100%"""
        self.pdf_canvas.zoom_to_actual()
    
    def on_zoom_changed(self, zoom_level):
        """عند تغيير مستوى التكبير"""
        zoom_percent = int(zoom_level * 100)
        self.zoom_label.setText(f"التكبير: {zoom_percent}%")
    
    def rotate_left(self):
        """تدوير عكس عقارب الساعة"""
        self.pdf_canvas.rotate_left()
    
    def rotate_right(self):
        """تدوير مع عقارب الساعة"""
        self.pdf_canvas.rotate_right()
    
    # ============================================================================
    # الأدوات والتعليقات
    # ============================================================================
    
    def set_tool(self, tool_name):
        """تعيين الأداة النشطة"""
        # تحديث حالة أزرار الأدوات
        self.hand_tool_action.setChecked(tool_name == "hand")
        self.select_tool_action.setChecked(tool_name == "select")
        self.highlight_tool_action.setChecked(tool_name == "highlight")
        self.underline_tool_action.setChecked(tool_name == "underline")
        self.strikeout_tool_action.setChecked(tool_name == "strikeout")
        self.rectangle_tool_action.setChecked(tool_name == "rectangle")
        self.circle_tool_action.setChecked(tool_name == "circle")
        self.note_tool_action.setChecked(tool_name == "note")
        
        # تعيين وضع التفاعل في لوحة PDF
        self.pdf_canvas.set_interaction_mode(tool_name)
        
        # عرض رسالة في شريط الحالة
        tool_names = {
            "hand": "أداة اليد",
            "select": "أداة التحديد",
            "highlight": "أداة التظليل",
            "underline": "أداة الخط السفلي",
            "strikeout": "أداة الشطب",
            "rectangle": "أداة المستطيل",
            "circle": "أداة الدائرة",
            "note": "أداة الملاحظة"
        }
        
        self.status_bar.showMessage(f"الأداة النشطة: {tool_names.get(tool_name, tool_name)}", 2000)
    
    def on_annotation_added(self, annotation_data):
        """عند إضافة تعليق توضيحي"""
        self.sidebar.add_annotation(annotation_data)
        self.status_bar.showMessage("تم إضافة تعليق توضيحي", 2000)
    
    # ============================================================================
    # عرض واجهة المستخدم
    # ============================================================================
    
    def update_page_info(self):
        """تحديث معلومات الصفحة"""
        if self.pdf_handler:
            self.page_label.setText(
                f"الصفحة: {self.pdf_canvas.current_page + 1}/{self.pdf_handler.total_pages}"
            )
    
    def update_cursor_position(self, pos):
        """تحديث موضع المؤشر"""
        if self.pdf_canvas.page_image:
            img_pos = pos - self.pdf_canvas.image_offset
            self.cursor_label.setText(f"X: {img_pos.x()}, Y: {img_pos.y()}")
    
    def toggle_toolbar(self):
        """إظهار/إخفاء شريط الأدوات"""
        self.main_toolbar.setVisible(not self.main_toolbar.isVisible())
    
    def toggle_statusbar(self):
        """إظهار/إخفاء شريط الحالة"""
        self.status_bar.setVisible(not self.status_bar.isVisible())
    
    def toggle_sidebar(self):
        """إظهار/إخفاء الشريط الجانبي"""
        self.left_dock.setVisible(not self.left_dock.isVisible())
        self.right_dock.setVisible(not self.right_dock.isVisible())
    
    def toggle_fullscreen(self):
        """تبديل وضع ملء الشاشة"""
        if self.is_fullscreen:
            self.showNormal()
            if self.window_state_before_fullscreen:
                self.restoreState(self.window_state_before_fullscreen)
            self.is_fullscreen = False
        else:
            self.window_state_before_fullscreen = self.saveState()
            self.showFullScreen()
            self.is_fullscreen = True
    
    # ============================================================================
    # النوافذ المنبثقة
    # ============================================================================
    
    def show_properties(self):
        """إظهار نافذة خصائص الملف"""
        if not self.pdf_handler.doc:
            QMessageBox.warning(self, "تحذير", "لا يوجد ملف مفتوح")
            return
        
        metadata = self.pdf_handler.get_metadata()
        dialog = PropertiesDialog(metadata, self)
        dialog.exec_()
    
    def show_preferences(self):
        """إظهار نافذة التفضيلات"""
        dialog = SettingsDialog(self)
        if dialog.exec_():
            # تطبيق التغييرات
            theme = dialog.get_selected_theme()
            self.apply_theme(theme)
    
    def show_about(self):
        """إظهار نافذة حول"""
        dialog = AboutDialog(self)
        dialog.exec_()
    
    def show_help(self):
        """إظهار دليل الاستخدام"""
        QMessageBox.information(
            self,
            "دليل الاستخدام",
            "قارئ PDF احترافي\n\n"
            "اختصارات لوحة المفاتيح:\n"
            "• Ctrl+O: فتح ملف\n"
            "• Ctrl+S: حفظ\n"
            "• Ctrl+F: بحث\n"
            "• PgUp/PgDown: التنقل بين الصفحات\n"
            "• Ctrl++/Ctrl+-: التكبير/التصغير\n"
            "• F11: ملء الشاشة\n"
            "\n"
            "للمساعدة الإضافية، تفضل بزيارة موقع المشروع."
        )
    
    # ============================================================================
    # الإعدادات والتخصيص
    # ============================================================================
    
    def apply_theme(self, theme_name):
        """تطبيق سمة"""
        stylesheet = self.theme_manager.get_stylesheet(theme_name)
        self.setStyleSheet(stylesheet)
        self.save_theme_preference(theme_name)
    
    def load_settings(self):
        """تحميل الإعدادات"""
        # تحميل السمة
        theme = self.settings.value("theme", "light")
        self.apply_theme(theme)
        
        # تحميل الملفات الحديثة
        self.recent_files = self.settings.value("recent_files", [])
        self.update_recent_files_menu()
        
        # تحميل حجم النافذة وموضعها
        geometry = self.settings.value("window_geometry")
        if geometry:
            self.restoreGeometry(geometry)
    
    def save_settings(self):
        """حفظ الإعدادات"""
        # حفظ السمة
        self.settings.setValue("theme", self.theme_manager.get_current_theme())
        
        # حفظ الملفات الحديثة
        self.settings.setValue("recent_files", self.recent_files[:10])
        
        # حفظ حجم النافذة وموضعها
        self.settings.setValue("window_geometry", self.saveGeometry())
        
        # حفظ حالة النافذة
        self.settings.setValue("window_state", self.saveState())
        
        self.settings.sync()
    
    def save_theme_preference(self, theme_name):
        """حفظ تفضيل السمة"""
        self.theme_manager.set_current_theme(theme_name)
    
    def load_window_state(self):
        """تحميل حالة النافذة"""
        state = self.settings.value("window_state")
        if state:
            self.restoreState(state)
    
    def add_to_recent_files(self, file_path):
        """إضافة ملف إلى قائمة الملفات الحديثة"""
        if file_path in self.recent_files:
            self.recent_files.remove(file_path)
        
        self.recent_files.insert(0, file_path)
        
        # حفظ فقط آخر 10 ملفات
        self.recent_files = self.recent_files[:10]
        
        self.update_recent_files_menu()
    
    def update_recent_files_menu(self):
        """تحديث قائمة الملفات الحديثة"""
        self.open_recent_menu.clear()
        
        if not self.recent_files:
            action = QAction("لا توجد ملفات حديثة", self)
            action.setEnabled(False)
            self.open_recent_menu.addAction(action)
            return
        
        for file_path in self.recent_files:
            if os.path.exists(file_path):
                action = QAction(os.path.basename(file_path), self)
                action.setData(file_path)
                action.triggered.connect(lambda checked, path=file_path: self.open_file(path))
                self.open_recent_menu.addAction(action)
        
        self.open_recent_menu.addSeparator()
        clear_action = QAction("مسح القائمة", self)
        clear_action.triggered.connect(self.clear_recent_files)
        self.open_recent_menu.addAction(clear_action)
    
    def clear_recent_files(self):
        """مسح قائمة الملفات الحديثة"""
        self.recent_files = []
        self.update_recent_files_menu()
        self.settings.setValue("recent_files", [])
    
    def load_last_file(self):
        """تحميل آخر ملف تم فتحه"""
        if self.recent_files and os.path.exists(self.recent_files[0]):
            reply = QMessageBox.question(
                self,
                "فتح آخر ملف",
                f"هل تريد فتح آخر ملف:\n{os.path.basename(self.recent_files[0])}?",
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.open_file(self.recent_files[0])
    
    # ============================================================================
    # إدارة التقدم
    # ============================================================================
    
    def show_progress(self, message):
        """إظهار شريط التقدم"""
        self.progress_bar.show()
        self.progress_bar.setRange(0, 0)  # وضع غير محدد
        self.status_bar.showMessage(message)
        QApplication.processEvents()
    
    def hide_progress(self):
        """إخفاء شريط التقدم"""
        self.progress_bar.hide()
        self.status_bar.clearMessage()
    
    # ============================================================================
    # أحداث النافذة
    # ============================================================================
    
    def closeEvent(self, event):
        """معالجة إغلاق النافذة"""
        # حفظ الإعدادات
        self.save_settings()
        
        # إغلاق ملف PDF
        self.pdf_handler.close_pdf()
        
        # تأكيد الإغلاق
        reply = QMessageBox.question(
            self,
            'تأكيد الخروج',
            'هل أنت متأكد من الخروج؟',
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            event.accept()
        else:
            event.ignore()


